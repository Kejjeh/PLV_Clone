# PLV Clone — environment variables
# Copy this file to .env and adjust as needed.
# All variables use the PLV_ prefix.

# ── Data directories ──────────────────────────────────────────────
PLV_RAW_DATA_DIR=data/raw
PLV_PROCESSED_DIR=data/processed
PLV_MODELS_DIR=data/models
PLV_OUTPUTS_DIR=data/outputs

# ── Training / validation / test windows ─────────────────────────
PLV_TRAIN_START=2021-04-01
PLV_TRAIN_END=2023-11-01
PLV_VAL_START=2024-03-20
PLV_VAL_END=2024-10-31
PLV_TEST_START=2025-03-20
PLV_TEST_END=2025-11-01

# Set to true to extend training back to the COVID-shortened 2020 season
PLV_INCLUDE_2020=false

# ── Qualification thresholds ──────────────────────────────────────
PLV_MIN_PITCHES_PLV=100
PLV_MIN_PA_PROCESS=150

# ── LightGBM hyperparameters ──────────────────────────────────────
PLV_LGBM_N_ESTIMATORS=800
PLV_LGBM_LEARNING_RATE=0.05
PLV_LGBM_NUM_LEAVES=63
PLV_LGBM_EARLY_STOPPING=50
PLV_RANDOM_SEED=42

# ── Scaling targets ───────────────────────────────────────────────
PLV_PLV_LEAGUE_AVG=5.0
PLV_PLUS_METRIC_CENTER=100.0
PLV_PLUS_METRIC_STD_SCALE=10.0

# ── Ingestion ─────────────────────────────────────────────────────
PLV_STATCAST_CHUNK_DAYS=7

# ── ESPN Fantasy Baseball (private league) ────────────────────────
# Cookies are personal; never commit your real `.env`.
# Grab from your browser:
#   1. Log in at https://fantasy.espn.com/baseball
#   2. DevTools → Application → Cookies → fantasy.espn.com
#   3. Copy the `SWID` and `espn_s2` values into the variables below.
# League id: the number after `leagueId=` in your league URL.
ESPN_LEAGUE_ID=000000
ESPN_YEAR=2026
ESPN_SWID={00000000-0000-0000-0000-000000000000}
ESPN_S2=paste-your-long-urlencoded-espn_s2-cookie-here
