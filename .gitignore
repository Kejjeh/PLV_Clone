# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Claude Code session state (not for tracking),
# but DO track repo-level skills (committable workflows).
# Need .claude/* form (not .claude/) so negations below can re-include.
.claude/*
!.claude/skills/

# Virtual environments
.venv/
venv/
env/
.env
*.env

# Keep .env.example
!.env.example

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Logs
logs/
*.log
data/outputs/review_pipeline.log

# ── Data: raw Statcast (large, regenerable via pybaseball) ──────────────────
data/raw/*.parquet

# Keep the raw manifest (small, descriptive)
!data/raw/manifest.json

# ── Data: processed intermediates (all generated) ───────────────────────────
data/processed/

# ── Data: output parquets (binary, regenerable; keep CSVs for audit) ────────
data/outputs/*.parquet

# ── Models: binary pkl artifacts (regenerable via training pipeline) ─────────
data/models/*.pkl

# Keep all JSON in data/models (calibration, scaling, positions, league config)
!data/models/*.json

# ── xFP cache: large Statcast parquets (regenerable via build_sp_multiyr.py) ─
data/research/xfp_cache/*.parquet
data/research/xfp_cache/*.parquet.bak

# Keep aggregated CSVs in xfp_cache (training reference, smaller)
!data/research/xfp_cache/*.csv

# Archetype career panels — regenerated daily by build_*_archetypes.py
data/research/hitter_archetype_career_panel.parquet
data/research/sp_archetype_career_panel.parquet
data/research/rp_archetype_career_panel.parquet

# HR-14d analog research scratch (regenerable from statcast cache)
data/research/hr14d_*.parquet
data/research/batter_name_map.parquet

# Triangulate mega-research ephemeral outputs (live roster + FA snapshots)
data/research/triangulate_universe/

# Research archive — historical snapshots, local-only (see _archive/README.md)
data/research/_archive/

# Exploratory scratch (underscore-prefixed scripts + their outputs)
scripts/_*.py
data/outputs/_*

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Standalone xfp-model repo (separate git repo, copies of files)
xfp-model/
