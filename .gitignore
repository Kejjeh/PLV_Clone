# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Claude Code session state (not for tracking),
# but DO track repo-level skills (committable workflows).
# Need .claude/* form (not .claude/) so negations below can re-include.
.claude/*
!.claude/skills/

# Virtual environments
.venv/
venv/
env/
.env
*.env

# Keep .env.example
!.env.example

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/

# Cached full test/build logs from scripts/ci/run_summary.py
.cache/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Logs
logs/
*.log
data/outputs/review_pipeline.log

# ── Data: raw Statcast (large, regenerable via pybaseball) ──────────────────
data/raw/*.parquet

# Keep the raw manifest (small, descriptive)
!data/raw/manifest.json

# ── Data: processed intermediates (all generated) ───────────────────────────
data/processed/

# ── Data: output parquets (binary, regenerable; keep CSVs for audit) ────────
data/outputs/*.parquet

# ── Models: binary pkl artifacts (regenerable via training pipeline) ─────────
data/models/*.pkl

# Keep all JSON in data/models (calibration, scaling, positions, league config)
!data/models/*.json

# ── xFP cache: large Statcast parquets (regenerable via build_sp_multiyr.py) ─
data/research/xfp_cache/*.parquet
# .bak backups of ANY cache file (the refresh writes them) — the old
# *.parquet.bak-only rule let a 64 MB rolling_hitters CSV .bak into git
# (audit 2026-07-19; git rm --cached'd the same day).
data/research/xfp_cache/*.bak

# ESPN snapshot layer (refresh-run network diet, audit 2026-07-19 F3) —
# short-TTL pickles/JSON regenerated every refresh; never track.
data/research/espn_snapshot/

# Skill-engine scratch state (2026-07-20): churn plans + whats-new marker are
# ephemeral; golden-run holds prod-output copies mid-verification. NOTE:
# decision_gates.json is deliberately TRACKED (durable decision state).
data/research/churn_plans/
data/research/whats_new_last_seen.json
data/research/.golden_run/

# Disk-cache for the triangulate perf layer (pickled snapshots/decline-lens keyed on
# statcast mtime,size; rebuilt on demand — binary, rotates per refresh, never track).
data/research/xfp_cache/.build_cache/

# Raw MLB Stats API gameLog JSON cache for the as-of SB source (~5.7k files,
# regenerable via build_batter_sb_gamelog.py pull; resume-safe request cache).
data/research/xfp_cache/sb_gamelog_raw/

# Raw MLB Stats API gameLog JSON cache for the subseason variance-bands panel
# (~5k gz files 2010-2025, regenerable via build_subseason_variance_bands.py pull).
data/research/xfp_cache/variance_gamelog_raw/

# Keep aggregated CSVs in xfp_cache (training reference, smaller)
!data/research/xfp_cache/*.csv

# Archetype career panels — regenerated daily by build_*_archetypes.py
data/research/hitter_archetype_career_panel.parquet
data/research/sp_archetype_career_panel.parquet
data/research/rp_archetype_career_panel.parquet

# HR-14d analog research scratch (regenerable from statcast cache)
data/research/hr14d_*.parquet
data/research/batter_name_map.parquet

# Triangulate mega-research ephemeral outputs (live roster + FA snapshots)
data/research/triangulate_universe/

# Research archive — historical snapshots, local-only (see _archive/README.md)
data/research/_archive/

# Intermediate backtest cache dirs (e.g. _cache_il_censor/, _cache_survivorship/)
# Created by scripts/_oneoff/ research scripts; pure noise for repo tracking.
data/research/_cache_*/

# Exploratory scratch (underscore-prefixed scripts + their outputs)
scripts/_*.py
data/outputs/_*

# CodeGraph index (generated, regenerable via `codegraph init`)
.codegraph/

# CodeGraph index hygiene: keep dead/one-off trees OUT of the semantic index so
# symbol search isn't diluted by stale v9/v10/v11 dupes. CodeGraph 0.9.9 has no
# ignore config of its own but DOES honor .gitignore. These dirs stay tracked in
# git (already committed) — gitignore only affects untracked files, so listing
# them here is purely an indexer hint, not a git removal.
scripts/xfp/archive/
scripts/xfp/research/
scripts/xfp/_research/
scripts/_oneoff/
scripts/xfp/_attic/
scripts/_attic/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Standalone xfp-model repo (separate git repo, copies of files)
xfp-model/

# Large regenerated caches/exports — rebuilt each refresh (build_rolling_*.py,
# build_player_profiles_dashboard.py). Untracked to defuse GitHub's 100MB push
# limit (rolling_hitters hit 63MB). Kept on disk; never hand-edited. 2026-06-27.
data/research/xfp_cache/rolling_hitters_2018_2026.csv
data/research/xfp_cache/rolling_relievers_2018_2026.csv
data/research/xfp_cache/rolling_pitchers_2018_2026.csv
data/outputs/player_profiles.html
data/outputs/player_profiles_data.js

# Auto-created refresh backups — never hand-edited; the refresh writes fresh
# each run. Untracked 2026-07-04 (item 17) to stop permanent git growth.
data/outputs/*.bak*

# Dated daily snapshot files — consumers only read the LATEST (sorted(glob)[-1])
# or the *_latest companion; boom_stack history is archived to parquet. The
# per-day copies are pure redundancy (~1.5MB/day of permanent git growth).
# Untracked 2026-07-04 (item 17); the non-dated *_latest files stay tracked.
data/outputs/closer_leaders_2*.json
data/outputs/sp_boom_stack_full_pool_2*.json
data/outputs/sp_boom_stack_full_pool_2*.md
data/outputs/stream_the_stack_2*.json
data/outputs/stream_the_stack_2*.md
data/outputs/live_blend_xfp_2*.csv
data/outputs/hitter_boom_stack_2*.json
data/outputs/hitter_boom_stack_2*.md
data/outputs/streamer_decision_2*.md

# Weekly FP substrate — 31MB; its producer is now a staged refresh step, kept
# on disk but untracked 2026-07-04 (item 17).
data/research/week_level_substrate.csv

# ── IL transaction resume chunks (parquet, regenerable via fetch_il_transactions.py)
data/research/xfp_cache/il_tx_chunks/
# ── FG RoS projection daily snapshots: ~7MB/day accumulation, disk-only panel
#    (manifest stays tracked; snapshots are consumed locally by validation runs)
data/research/fg_proj_cache/*.csv
!data/research/fg_proj_cache/manifest.csv
# ── sigma-study snapshot cache: git-history-recovered daily projection CSVs
#    (regenerable via data/research/sigma_study_cache/run_sigma_study.py)
data/research/sigma_study_cache/rh3_2026-*.csv
data/research/sigma_study_cache/rp3_2026-*.csv
# ── box-score-era raw API caches (regenerable via build_panels.py / probes)
data/research/boxscore_era/raw/
data/research/boxscore_era/raw_probe/
